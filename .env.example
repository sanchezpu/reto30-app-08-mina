# Configuración de la API de Mina.
#
# En el servidor este archivo NO vive junto al código: está en
# /etc/reto30/app08.env con permisos 600, fuera de /var/www, para que ningún
# despliegue lo pise y nginx no pueda servirlo por accidente. El contenedor lo
# recibe con --env-file, así que se lee AL ARRANCAR: después de editarlo hay
# que reiniciar (docker restart reto30-app08-api).

# Clave de OpenRouter. Sin ella la API responde 422 con un mensaje claro en vez
# de fingir que funciona.
OPENROUTER_API_KEY=

# Cualquier modelo del catálogo de OpenRouter. El de fábrica lleva 1M de
# contexto, que es lo que importa cuando alguien pega 300 reseñas de golpe.
MINA_MODELO=anthropic/claude-sonnet-5

# Análisis por hora y por IP.
MINA_LIMITE_HORA=5

# Puerto de la API. Va con nombre propio y no PORT porque un PORT suelto en el
# entorno de la máquina se llevaba el puerto sin avisar.
MINA_PUERTO=3008
